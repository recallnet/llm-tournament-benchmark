      "content": "function runGameOfLife(canvasId) {\n  const canvas = document.getElementById(canvasId);\n  if (!canvas) return;\n  canvas.width = 500;\n  canvas.height = 500;\n  const ctx = canvas.getContext('2d');\n  const CELL_SIZE = 20;\n  const COLS = canvas.width / CELL_SIZE;\n  const ROWS = canvas.height / CELL_SIZE;\n  const emojis = ['\ud83d\udfe5','\ud83d\udfe7','\ud83d\udfe8','\ud83d\udfe9','\ud83d\udfe6','\ud83d\udfea'];\n  let grid = Array.from({length: ROWS}, () => Array.from({length: COLS}, () => ({alive:false, age:0, fade:0})));\n  let running = false;\n  let speed = 5;\n  const genInterval = 1000 / speed;\n  let lastGen = performance.now();\n  function draw() {\n    ctx.clearRect(0,0,canvas.width,canvas.height);\n    ctx.textAlign='center';ctx.textBaseline='middle';ctx.font=`${CELL_SIZE-2}px serif`;\n    for (let r=0;r<ROWS;r++){\n      for (let c=0;c<COLS;c++){\n        const cell=grid[r][c];\n        if (cell.alive||cell.fade>0){\n          let emoji=emojis[Math.min(cell.age,emojis.length-1)];\n          ctx.globalAlpha=cell.fade||1;\n          ctx.fillText(emoji, c*CELL_SIZE+CELL_SIZE/2, r*CELL_SIZE+CELL_SIZE/2);\n          ctx.globalAlpha=1;\n        }\n      }\n    }\n  }\n  function nextGen(){\n    const newGrid=Array.from({length:ROWS},()=>Array.from({length:COLS},()=>({alive:false,age:0,fade:0})));\n    for (let r=0;r<ROWS;r++){\n      for (let c=0;c<COLS;c++){\n        let neighbors=0;\n        for (let dr=-1;dr<=1;dr++){\n          for (let dc=-1;dc<=1;dc++){\n            if (dr===0&&dc===0)continue;\n            let nr=r+dr,nc=c+dc;\n            if (nr>=0&&nr<ROWS&&nc>=0&&nc<COLS&&grid[nr][nc].alive)neighbors++;\n          }\n        }\n        const cell=grid[r][c];\n        if (cell.alive){\n          if (neighbors===2||neighbors===3){\n            newGrid[r][c].alive=true;\n            newGrid[r][c].age=cell.age+1;\n          }else{\n            newGrid[r][c].fade=1;\n          }\n        }else{\n          if (neighbors===3){\n            newGrid[r][c].alive=true;\n            newGrid[r][c].age=0;\n          }\n        }\n      }\n    }\n    grid=newGrid;\n  }\n  function updateFade(){\n    for (let r=0;r<ROWS;r++){\n      for (let c=0;c<COLS;c++){\n        const cell=grid[r][c];\n        if (!cell.alive&&cell.fade>0){\n          cell.fade-=0.05;\n          if (cell.fade<0)cell.fade=0;\n        }\n      }\n    }\n  }\n  function loop(time){\n    if (running && time-lastGen>=genInterval){nextGen();lastGen=time;}\n    updateFade();draw();requestAnimationFrame(loop);\n  }\n  requestAnimationFrame(loop);\n  canvas.addEventListener('click',(e)=>{\n    const rect=canvas.getBoundingClientRect();\n    const x=e.clientX-rect.left,y=e.clientY-rect.top;\n    const c=Math.floor(x/CELL_SIZE),r=Math.floor(y/CELL_SIZE);\n    if (r>=0&&r<ROWS&&c>=0&&c<COLS){\n      const cell=grid[r][c];\n      cell.alive=!cell.alive;cell.age=cell.alive?0:cell.age;\n    }\n  });\n  const container=document.createElement('div');container.style.marginTop='10px';\n  const startBtn=document.createElement('button');startBtn.textContent='Start';\n  const stopBtn=document.createElement('button');stopBtn.textContent='Stop';\n  const randomBtn=document.createElement('button');randomBtn.textContent='Randomize';\n  const clearBtn=document.createElement('button');clearBtn.textContent='Clear';\n  const patternSel=document.createElement('select');\n  ['Glider','Blinker','GosperGun','Pulsar'].forEach(p=>{let opt=document.createElement('option');opt.value=p;opt.textContent=p;patternSel.appendChild(opt);});\n  const speedLbl=document.createElement('label');speedLbl.textContent='Speed:';\n  const speedInput=document.createElement('input');speedInput.type='range';speedInput.min='1';speedInput.max='10';speedInput.value='5';\n  container.append(startBtn,stopBtn,randomBtn,clearBtn,patternSel,speedLbl,speedInput);\n  document.body.appendChild(container);\n  startBtn.onclick(()=>{running=true;});\n  stopBtn.onclick(()=>{running=false;});\n  speedInput.oninput(()=>{speed=+speedInput.value;});\n  randomBtn.onclick(()=>{for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++)grid[r][c].alive=Math.random()<0.3;});\n  clearBtn.onclick(()=>{grid=Array.from({length:ROWS},()=>Array.from({length:COLS},()=>({alive:false,age:0,fade:0})));});\n  patternSel.onchange(()=>{const p=patternSel.value;grid=Array.from({length:ROWS},()=>Array.from({length:COLS},()=>({alive:false,age:0,fade:0})));const mid={r:ROWS/2,c:COLS/2};\n    const patterns={Glider:[[0,0],[1,0],[2,0],[2,-1],[1,2]],\n                    Blinker:[[0,-1],[0,0],[0,1]],\n                    GosperGun:[\n  [0,24],[1,22],[1,24],[2,13],[2,14],[2,20],[2,21],[2,34],[2,35],\n  [3,12],[3,15],[3,20],[3,21],[3,34],[3,35],[4,12],[4,15],[4,20],[4,21],[4,34],[4,35],\n  [5,13],[5,14],[6,25],[6,26],[7,25],[7,26],[8,23],[8,24],[8,25],[8,26],[8,27],[9,24],[9,25],\n  [10,25],[10,26],[11,26],[12,27],[13,27],[13,28],[15,24],[15,25],[15,26],[16,23],[16,24],[16,25],[16,26],[16,27],[17,24],[17,25],[17,26],[18,24],[18,25],[18,26],\n  [19,27],[19,28],[20,27],[20,28],[21,27],[21,28],[22,27],[22,28],[23,27],[23,28],[24,27],[24,28],[24,29],[25,27],[25,28],[26,28],[26,29],[27,28],[27,29],[28,28],[28,29],[28,30],[29,28],[29,29],[29,30],[30,28],[30,29],[31,28],[31,29],[32,28],[32,29],[33,28],[33,29],[34,28],[34,29],[35,28],[35,29],\n  [36,28],[36,29],[37,28],[37,29],[38,28],[38,29],[39,28],[39,29],[40,28],[40,29],[41,28],[41,29],[42,28],[42,29],[43,28],[43,29],[44,28],[44,29],[45,28],[45,29],[46,28],[46,29],[47,28],[47,29],[48,28],[48,29],[49,28],[49,29],[50,28],[50,29],[51,28],[51,29],[52,28],[52,29],[53,28],[53,29],[54,28],[54,29],[55,28],[55,29],[56,28],[56,29],[57,28],[57,29],[58,28],[58,29],[59,28],[59,29],[60,28],[60,29],[61,28],[61,29],[62,28],[62,29],[63,28],[63,29],[64,28],[64,29],[65,28],[65,29],[66,28],[66,29],[67,28],[67,29],[68,28],[68,29],[69,28],[69,29],[70,28],[70,29],[71,28],[71,29],[72,28],[72,29],[73,28],[73,29],[74,28],[74,29],[75,28],[75,29],[76,28],[76,29],[77,28],[77,29],[78,28],[78